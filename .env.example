# Copia este archivo a .env y rellena los valores.

PORT=3000
# Ruta de la base de datos SQLite
DB_PATH=./data/bot.db
# Versión de la Graph API de Meta
GRAPH_VERSION=v23.0

# Token que inventas tú y pegas en el panel de Meta al configurar el webhook
VERIFY_TOKEN=pon-aqui-un-texto-secreto
# App Secret (Meta App > Configuración > Básica). Si usas también el login de
# Instagram, añade su secreto separado por comas: secreto1,secreto2
APP_SECRET=

# Contraseña del panel. Obligatoria si el panel se abre a través del túnel.
ADMIN_PASSWORD=

# true = no llama a Meta, solo registra en consola lo que enviaría (para probar)
DRY_RUN=false

# --- Facebook Messenger (Página) ---
PAGE_ID=
PAGE_ACCESS_TOKEN=

# --- Instagram ---
# Con "Instagram API with Instagram Login": host graph.instagram.com y token de IG.
# Con "Instagram via Facebook Login": host graph.facebook.com y el token de la Página.
IG_USER_ID=
IG_ACCESS_TOKEN=
IG_GRAPH_HOST=graph.instagram.com

# --- WhatsApp Cloud API ---
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
